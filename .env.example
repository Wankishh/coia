# Harness
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=coia_agents
DEMO_DATABASE_URL=postgresql+psycopg2://demo:demo@demo-db:5432/demo
WORKSPACE_ROOT=/app/data/agent_workspaces
HARNESS_HOST=0.0.0.0
HARNESS_PORT=8000
# Sync chat turn timeout (seconds); chat does not create ExecutionLog
CHAT_TIMEOUT_SECONDS=120

# Local Ollama (OpenAI-compatible). Used when an ollama agent has no base_url override.
# From Docker, host.docker.internal reaches the host (compose sets host-gateway on Linux).
# Host/LAN examples: http://127.0.0.1:11434/v1  or  http://192.168.1.10:11434/v1
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Seed persona (scripts/seed_demo.py)
SEED_AGENT_NAME=Financial Analyst
SEED_AGENT_ROLE=financial_analyst
SEED_AGENT_PROVIDER=openai
SEED_AGENT_MODEL=gpt-4o-mini
SEED_CRON_SCHEDULE=

# Optional: copy into the seeded agent's api_key field once (NOT used by the harness at runtime).
# Prefer entering keys per-agent in the admin UI (/admin/).
# SEED_AGENT_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# SEED_AGENT_PROVIDER=openai   # openai | anthropic | google | openrouter | ollama
# SEED_AGENT_MODEL=gpt-4o-mini # or e.g. openai/gpt-4o-mini for openrouter; llama3.2 for ollama
